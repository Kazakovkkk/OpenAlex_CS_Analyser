OPENALEX_API_KEY=

# Пароли ClickHouse для config/app.toml: файл называет только имена переменных,
# значения берутся отсюда (или из реального окружения — оно сильнее .env).
# В дистрибутиве эти переменные задаёт Compose.
# CLICKHOUSE_ETL_WRITER_PASSWORD=
# CLICKHOUSE_GO_WRITER_PASSWORD=
# ETL_ENV_FILE=.env

# Optional operational defaults for the CLI.
# ETL_ADDR=:8081
# ETL_WORKERS=4
# ETL_BATCH_SIZE=10000
# ETL_RPS_LIMIT=20
# ETL_SAMPLE=tmp/works_sample_12k.jsonl.gz
# ETL_CHECKPOINT_DIR=tmp/checkpoints
